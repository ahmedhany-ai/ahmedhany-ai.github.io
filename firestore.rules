rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ahmedhany152004@gmail.com';
    }

    function isValidProductOrder() {
      let product = get(/databases/$(database)/documents/projects/$(request.resource.data.itemId)).data;
      return request.resource.data.keys().hasOnly([
          'itemId', 'itemTitle', 'price', 'currency', 'customerName',
          'customerEmail', 'paymentMethod', 'transactionReference',
          'status', 'createdAt'
        ])
        && request.resource.data.itemId is string
        && product.itemType == 'product'
        && product.title == request.resource.data.itemTitle
        && product.price == request.resource.data.price
        && product.currency == request.resource.data.currency
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.currency in ['EGP', 'USD']
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail.size() > 0
        && request.resource.data.customerEmail.size() <= 254
        && request.resource.data.paymentMethod in ['external', 'instapay', 'vodafone_cash']
        && request.resource.data.transactionReference is string
        && request.resource.data.transactionReference.size() <= 160
        && (request.resource.data.paymentMethod == 'external'
          || request.resource.data.transactionReference.size() > 0)
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && (request.resource.data.paymentMethod != 'external'
          || (product.paymentUrl is string && product.paymentUrl.size() > 0));
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /product-deliveries/{productId} {
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if isValidProductOrder();
      allow read, update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId == 'store';
      allow create, update, delete: if settingId == 'store' && isAdmin();
    }
  }
}
